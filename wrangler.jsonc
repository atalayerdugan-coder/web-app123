{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app123",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "974e09a1-212a-4e80-99d5-d1cef2264579","database_name": "web-app123" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "55d7fcc2b45e475dbfb30290ea70868d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
